{
  "name": "nono-web",
  "private": true,
  "scripts": {
    "postinstall": "node tools/build.cjs",
    "build": "node tools/build.cjs",
    "test": "node tests/smoke.cjs",
    "test:multiplayer": "firebase emulators:exec --project demo-nono --only database,auth \"node tests/multiplayer.cjs\"",
    "test:browser": "firebase emulators:exec --project demo-nono --only database,auth \"node tests/browser-multiplayer.cjs\"",
    "test:home": "node tests/home-sidebars.cjs",
    "test:community": "node tests/community-rewards.cjs",
    "test:account": "node tests/account-auth.cjs",
    "test:answers": "node tests/answer-bitpack.cjs && node tools/seed-packed-answers.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0",
    "playwright": "^1.56.0"
  }
}
