{
  "name": "nono-web",
  "private": true,
  "scripts": {
    "postinstall": "node tools/build.cjs",
    "build": "node tools/build.cjs",
    "test": "node tests/smoke.cjs && node tests/smart-touch-controls.cjs",
    "test:multiplayer": "firebase emulators:exec --project demo-nono --only database,auth \"node tests/multiplayer.cjs\"",
    "test:browser": "firebase emulators:exec --project demo-nono --only database,auth \"node tests/browser-multiplayer.cjs\"",
    "test:home": "node tests/home-sidebars.cjs",
    "test:community": "node tests/community-rewards.cjs",
    "test:account": "node tests/account-auth.cjs",
    "test:answers": "node tests/answer-bitpack.cjs && node tests/sealed-puzzle.cjs && node tests/register-puzzle.cjs && node tests/prepare-puzzle.cjs && node tools/seed-packed-answers.cjs",
    "test:replay": "node tests/replay.cjs",
    "test:replay:multiplayer": "node tests/multiplayer-replay.cjs",
    "test:migrate": "node tests/seed-packed-migration.cjs",
    "test:catalog": "node tests/puzzle-catalog.cjs",
    "puzzle:add": "node tools/register-puzzle.cjs",
    "test:sealed": "node tests/sealed-puzzle.cjs",
    "test:register": "node tests/register-puzzle.cjs",
    "test:smart-touch": "node tests/smart-touch-controls.cjs",
    "test:random": "node tests/random-puzzles.cjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0",
    "playwright": "^1.56.0"
  }
}
