      "content": "illustrated cartridge shelf"
    },
    {
      "surface": "sidebar.decorative-star",
      "kind": "easter-egg",
      "content": "brief sparkle/message",
      "changesGameState": false
    }
  ],
  "noScreenshotAsInterface": true,
  "originalGraphicsOnly": true,
  "requiredReviews": [
    "desktop-render",
    "mobile-render",
    "active-game-render",
    "input-regression",
    "theme-switch",
    "data-preservation"
